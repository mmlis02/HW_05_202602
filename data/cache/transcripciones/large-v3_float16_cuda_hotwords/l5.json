 "segmentos": [
  {
   "start": 0.14,
   "end": 5.66,
   "text": "La Leña Dorada. Buenas noches. ¿Delivery? ¿O recojo en tienda?"
  },
  {
   "start": 6.16,
   "end": 10.76,
   "text": "Delivery, por favor. Es para una reunión familiar."
  },
  {
   "start": 12.52,
   "end": 14.88,
   "text": "Perfecto. ¿Qué le enviamos?"
  },
  {
   "start": 15.89,
   "end": 23.68,
   "text": "Dos pollos enteros, dos papas familiares y dos gaseosas de litro y medio."
  },
  {
   "start": 24.6,
   "end": 26.26,
   "text": "¿Dos pollos enteros?"
  },
  {
   "start": 26.26,
   "end": 28.76,
   "text": "Espere, déjeme preguntar."
  },
  {
   "start": 30.0,
   "end": 30.76,
   "text": "Ya."
  },
  {
   "start": 32.76,
   "end": 40.22,
   "text": "Mejor que sea un pollo entero y un medio pollo. Somos menos de lo que pensábamos."
  },
  {
   "start": 40.96,
   "end": 44.36,
   "text": "Bien. Un pollo entero y un medio pollo."
  },
  {
   "start": 45.4,
   "end": 49.98,
   "text": "¿Las dos papas familiares y las dos gaseosas de litro y medio se mantienen?"
  },
  {
   "start": 50.24,
   "end": 52.24,
   "text": "Sí, eso se mantiene."
  },
  {
   "start": 53.08,
   "end": 53.84,
   "text": "Perfecto."
  },
  {
   "start": 53.84,
   "end": 61.6,
   "text": "Perfecto. Como lleva pollo entero con papas familiares, tiene el dúo familiar 10 soles de descuento."
  },
  {
   "start": 61.98,
   "end": 65.28,
   "text": "Genial. ¿Viene con cremas?"
  },
  {
   "start": 66.1,
   "end": 71.04,
   "text": "Sí. Cada pollo trae su mayonesa, ketchup y ají."
  },
  {
   "start": 72.56,
   "end": 73.44,
   "text": "Perfecto."
  },
  {
   "start": 75.77,
   "end": 76.83,
   "text": "Dirección de la entrega."
  },
  {
   "start": 77.85,
   "end": 82.73,
   "text": "Avenida Los Laureles 2271."
  },
  {
   "start": 83.63,
   "end": 84.79,
   "text": "Bloque C."
  },
  {
   "start": 86.05,
   "end": 90.09,
   "text": "Departamento 504, en San Juan del Urigancho."
  },
  {
   "start": 93.57,
   "end": 97.85,
   "text": "2271. Bloque C. Departamento 504."
  },
  {
   "start": 98.67,
   "end": 99.53,
   "text": "Forma de pago."
  },
  {
   "start": 100.77,
   "end": 101.19,
   "text": "Yape."
  },
  {
   "start": 102.11,
   "end": 104.55,
   "text": "Muy bien. Le confirmo."
  },
  {
   "start": 105.49,
   "end": 113.81,
   "text": "Un pollo entero, un medio pollo, dos papas familiares y dos gaseosas de litro y medio."
  },
  {
   "start": 113.85,
   "end": 115.15,
   "text": "Con el dúo familiar."
  },
  {
   "start": 115.35,
   "end": 118.73,
   "text": "El total es 131 soles."
  },
  {
   "start": 120.13,
   "end": 121.29,
   "text": "131, perfecto."
  },
  {
   "start": 121.37,
   "end": 125.47,
   "text": "Le llega en una hora aproximadamente. Hoy tenemos bastante demanda."
  },
  {
   "start": 125.55,
   "end": 126.37,
   "text": "No hay problema, gracias."
  },
  {
   "start": 126.87,
   "end": 128.81,
   "text": "Gracias a usted. Buenas noches."
  },
  {
   "start": 129.63,
   "end": 130.21,
   "text": "Buenas noches."
  }
 ],
