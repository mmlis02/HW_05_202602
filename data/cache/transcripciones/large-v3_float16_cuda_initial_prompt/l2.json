 "segmentos": [
  {
   "start": 0.14,
   "end": 4.0,
   "text": "La Leña Dorada, buenas tardes, ¿en qué le puedo ayudar?"
  },
  {
   "start": 4.46,
   "end": 8.08,
   "text": "Buenas tardes, quiero pedir dos medios pollos, por favor."
  },
  {
   "start": 8.61,
   "end": 12.04,
   "text": "Dos medios pollos, muy bien, ¿algo más?"
  },
  {
   "start": 12.58,
   "end": 20.86,
   "text": "Espera, espera, si un medio cuesta 36, dos medios me salen 72, ¿cuánto está el entero?"
  },
  {
   "start": 21.43,
   "end": 23.26,
   "text": "El entero está 78."
  },
  {
   "start": 24.22,
   "end": 28.58,
   "text": "Entonces, mejor un pollo entero en vez de los dos medios, sale más barato."
  },
  {
   "start": 28.58,
   "end": 35.38,
   "text": "Claro, le cambio, un pollo entero en vez de los dos medios, ¿algo más?"
  },
  {
   "start": 36.22,
   "end": 37.54,
   "text": "Una porción de anticuchos."
  },
  {
   "start": 37.9,
   "end": 44.62,
   "text": "Una porción de anticuchos son tres palitos a 18 soles, ¿algo de tomar?"
  },
  {
   "start": 45.3,
   "end": 47.22,
   "text": "Una gaseosa de litro y medio."
  },
  {
   "start": 47.64,
   "end": 52.6,
   "text": "Una gaseosa de litro y medio, 9 soles, ¿papas?"
  },
  {
   "start": 52.86,
   "end": 55.12,
   "text": "No, papas no, gracias."
  },
  {
   "start": 55.62,
   "end": 58.06,
   "text": "Ah, tengo un código de la aplicación."
  },
  {
   "start": 58.06,
   "end": 59.0,
   "text": "Leña 5."
  },
  {
   "start": 60.02,
   "end": 63.44,
   "text": "Perfecto, con el código le descontamos 5 soles."
  },
  {
   "start": 64.2,
   "end": 65.36,
   "text": "Dirección de entrega."
  },
  {
   "start": 66.44,
   "end": 73.04,
   "text": "Avenida Las Gardeñas, 1580, en Pueblo Libre, es una casa de dos pisos con reja negra."
  },
  {
   "start": 73.9,
   "end": 81.74,
   "text": "Avenida Las Gardeñas, 1580, casa de dos pisos con reja negra, ¿cómo va a pagar?"
  },
  {
   "start": 82.24,
   "end": 84.94,
   "text": "En efectivo, pago con un billete de 100."
  },
  {
   "start": 85.84,
   "end": 86.68,
   "text": "Muy bien."
  },
  {
   "start": 88.06,
   "end": 89.34,
   "text": "Pasado, lleva vuelto."
  },
  {
   "start": 89.36,
   "end": 98.62,
   "text": "Entonces, le confirmo, un pollo entero, una porción de anticuchos y una gaseosa de litro y medio."
  },
  {
   "start": 99.02,
   "end": 101.9,
   "text": "El total es 95 soles."
  },
  {
   "start": 102.66,
   "end": 103.94,
   "text": "95, ok."
  },
  {
   "start": 104.48,
   "end": 108.22,
   "text": "Le llega en unos 40 minutos."
  },
  {
   "start": 109.1,
   "end": 111.52,
   "text": "Perfecto, muchas gracias."
  },
  {
   "start": 112.96,
   "end": 115.5,
   "text": "Gracias por su pedido."
  },
  {
   "start": 116.14,
   "end": 117.14,
   "text": "Buenas."
  },
  {
   "start": 117.16,
   "end": 117.72,
   "text": "Gracias."
  },
  {
   "start": 118.06,
   "end": 118.52,
   "text": "Bravo, Luis."
  }
 ],
