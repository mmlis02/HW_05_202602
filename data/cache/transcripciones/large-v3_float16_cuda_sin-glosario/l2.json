 "segmentos": [
  {
   "start": 0.14,
   "end": 4.0,
   "text": "La leña dorada. Buenas tardes. ¿En qué le puedo ayudar?"
  },
  {
   "start": 4.44,
   "end": 8.06,
   "text": "Buenas tardes. Quiero pedir dos medios pollos, por favor."
  },
  {
   "start": 8.42,
   "end": 12.04,
   "text": "Dos medios pollos. Muy bien. ¿Algo más?"
  },
  {
   "start": 12.56,
   "end": 20.86,
   "text": "Espera, espera. Si un medio cuesta 36, dos medios me salen 72. ¿Cuánto está el entero?"
  },
  {
   "start": 21.42,
   "end": 23.26,
   "text": "El entero está 78."
  },
  {
   "start": 24.2,
   "end": 28.58,
   "text": "Entonces, mejor un pollo entero en vez de los dos medios. Sale más barato."
  },
  {
   "start": 28.58,
   "end": 35.38,
   "text": "Claro. Le cambio. Un pollo entero en vez de los dos medios. ¿Algo más?"
  },
  {
   "start": 36.22,
   "end": 37.54,
   "text": "Una porción de anticuchos."
  },
  {
   "start": 37.92,
   "end": 44.62,
   "text": "Una porción de anticuchos son tres palitos a 18 soles. ¿Algo de tomar?"
  },
  {
   "start": 45.3,
   "end": 47.2,
   "text": "Una gaseosa de litro y medio."
  },
  {
   "start": 47.64,
   "end": 52.64,
   "text": "Una gaseosa de litro y medio, 9 soles. ¿Papas?"
  },
  {
   "start": 52.86,
   "end": 55.12,
   "text": "No. Papas no. Gracias."
  },
  {
   "start": 55.64,
   "end": 58.08,
   "text": "Ah, tengo un código de la aplicación."
  },
  {
   "start": 58.08,
   "end": 59.0,
   "text": "Leña 5."
  },
  {
   "start": 60.0,
   "end": 63.44,
   "text": "Perfecto. Con el código le descontamos 5 soles."
  },
  {
   "start": 64.18,
   "end": 65.36,
   "text": "Dirección de entrega."
  },
  {
   "start": 66.42,
   "end": 73.0,
   "text": "Avenida Las Gardenias, 1580, en Pueblo Libre. Es una casa de dos pisos con reja negra."
  },
  {
   "start": 73.88,
   "end": 81.74,
   "text": "Avenida Las Gardenias, 1580. Casa de dos pisos con reja negra. ¿Cómo va a pagar?"
  },
  {
   "start": 82.24,
   "end": 84.94,
   "text": "En efectivo. Pago con un billete de 100."
  },
  {
   "start": 85.82,
   "end": 86.68,
   "text": "Muy bien."
  },
  {
   "start": 88.08,
   "end": 101.9,
   "text": "El pasado lleva vuelto. Entonces le confirmo. Un pollo entero, una porción de anticuchos y una gaseosa de litro y medio. El total es 95 soles."
  },
  {
   "start": 102.62,
   "end": 103.96,
   "text": "95. Ok."
  },
  {
   "start": 104.46,
   "end": 108.22,
   "text": "Le llega en unos 40 minutos."
  },
  {
   "start": 109.06,
   "end": 111.52,
   "text": "Perfecto. Muchas gracias."
  },
  {
   "start": 112.44,
   "end": 116.66,
   "text": "Gracias por su pedido. Buenas."
  },
  {
   "start": 118.08,
   "end": 118.52,
   "text": "Bravo, Luis."
  },
  {
   "start": 118.84,
   "end": 119.3,
   "text": "Gracias."
  }
 ],
