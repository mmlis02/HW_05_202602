 "segmentos": [
  {
   "start": 0.14,
   "end": 5.66,
   "text": "La leña dorada. Buenas noches. ¿Delivery o recojo en tienda?"
  },
  {
   "start": 6.06,
   "end": 10.76,
   "text": "Delivery, por favor. Es para una reunión familiar."
  },
  {
   "start": 11.76,
   "end": 14.88,
   "text": "Perfecto. ¿Qué le enviamos?"
  },
  {
   "start": 15.84,
   "end": 23.68,
   "text": "Dos pollos enteros, dos papas familiares y dos gaseosas de litro y medio."
  },
  {
   "start": 24.5,
   "end": 26.26,
   "text": "¿Dos pollos enteros?"
  },
  {
   "start": 26.26,
   "end": 28.76,
   "text": "Espere, déjeme preguntar."
  },
  {
   "start": 29.96,
   "end": 40.22,
   "text": "Ya. Mejor que sea un pollo entero y un medio pollo. Somos menos de lo que pensábamos."
  },
  {
   "start": 40.96,
   "end": 44.36,
   "text": "Bien. Un pollo entero y un medio pollo."
  },
  {
   "start": 45.38,
   "end": 49.98,
   "text": "¿Las dos papas familiares y las dos gaseosas de litro y medio se mantienen?"
  },
  {
   "start": 50.24,
   "end": 52.24,
   "text": "Sí, eso se mantiene."
  },
  {
   "start": 53.02,
   "end": 56.24,
   "text": "Perfecto. Como lleva pollo entero..."
  },
  {
   "start": 56.26,
   "end": 61.6,
   "text": "El pollo entero con papas familiares tiene el dúo familiar. Diez soles de descuento."
  },
  {
   "start": 62.08,
   "end": 65.28,
   "text": "Genial. ¿Viene con cremas?"
  },
  {
   "start": 66.12,
   "end": 71.04,
   "text": "Sí. Cada pollo trae su mayonesa, ketchup y ají."
  },
  {
   "start": 72.6,
   "end": 73.44,
   "text": "Perfecto."
  },
  {
   "start": 75.79,
   "end": 76.83,
   "text": "Dirección de la entrega."
  },
  {
   "start": 77.89,
   "end": 82.73,
   "text": "Avenida Los Laureles, 2271."
  },
  {
   "start": 83.67,
   "end": 87.03,
   "text": "Bloque C, Departamento 504."
  },
  {
   "start": 87.77,
   "end": 90.11,
   "text": "En San Juan de Lurigancho."
  },
  {
   "start": 93.71,
   "end": 97.83,
   "text": "2271. Bloque C, Departamento 504."
  },
  {
   "start": 98.67,
   "end": 99.49,
   "text": "¿Forma de pago?"
  },
  {
   "start": 100.35,
   "end": 101.19,
   "text": "Yape."
  },
  {
   "start": 102.11,
   "end": 104.55,
   "text": "Muy bien. Le confirmo."
  },
  {
   "start": 105.49,
   "end": 113.81,
   "text": "Un pollo entero, un medio pollo, dos papas familiares y dos gaseosas de litro y medio."
  },
  {
   "start": 113.85,
   "end": 115.07,
   "text": "Con el dúo familiar."
  },
  {
   "start": 115.07,
   "end": 118.73,
   "text": "El total es 131 soles."
  },
  {
   "start": 120.01,
   "end": 121.29,
   "text": "¿131? Perfecto."
  },
  {
   "start": 121.33,
   "end": 125.49,
   "text": "Le llega en una hora aproximadamente. Hoy tenemos bastante demanda."
  },
  {
   "start": 125.53,
   "end": 126.39,
   "text": "No hay problema, gracias."
  },
  {
   "start": 126.85,
   "end": 128.81,
   "text": "Gracias a usted. Buenas noches."
  }
 ],
