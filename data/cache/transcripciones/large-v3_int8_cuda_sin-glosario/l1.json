 "segmentos": [
  {
   "start": 0.85,
   "end": 5.57,
   "text": "La Leña Dorada. Buenas noches. Le habla Javier. ¿En qué le puedo ayudar?"
  },
  {
   "start": 6.47,
   "end": 9.99,
   "text": "Hola, buenas noches. Quería hacer un pedido para delivery."
  },
  {
   "start": 10.67,
   "end": 13.11,
   "text": "Claro que sí. ¿Me dice qué va a pedir?"
  },
  {
   "start": 13.69,
   "end": 17.97,
   "text": "Un pollo al abrazo entero con unas papas familiares."
  },
  {
   "start": 18.72,
   "end": 24.95,
   "text": "Muy bien. Un pollo entero de 68 soles y una papa familiar de 14. ¿Algo para tomar?"
  },
  {
   "start": 26.01,
   "end": 34.07,
   "text": "Sí. Una jarra de chicha morada. No, mejor que sean dos jarras, que somos varios en la casa."
  },
  {
   "start": 34.87,
   "end": 40.59,
   "text": "Perfecto. Dos jarras de chicha morada a 12 soles cada una. ¿Alguna ensalada? ¿Algún postre?"
  },
  {
   "start": 41.77,
   "end": 46.99,
   "text": "No. Con eso está bien. ¿Tienen alguna promoción?"
  },
  {
   "start": 47.55,
   "end": 53.97,
   "text": "Sí. Como lleva pollo entero con papas familiares, aplica el dúo familiar. 10 soles de descuento."
  },
  {
   "start": 54.95,
   "end": 58.81,
   "text": "Ah, buenísimo. ¿El pollo viene con cremas?"
  },
  {
   "start": 59.19,
   "end": 62.95,
   "text": "Sí. Viene con mayonesa, ketchup y ají de la casa."
  },
  {
   "start": 63.67,
   "end": 65.91,
   "text": "Que manden bastante ají, por favor."
  },
  {
   "start": 66.23,
   "end": 69.47,
   "text": "Listo. Lo anoto. ¿A qué dirección se lo enviamos?"
  },
  {
   "start": 70.17,
   "end": 76.65,
   "text": "Calle Los Cedros, 245, Departamento 302, en Surco."
  },
  {
   "start": 77.39,
   "end": 83.17,
   "text": "Calle Los Cedros, 245, Departamento 302. ¿Alguna referencia?"
  },
  {
   "start": 83.67,
   "end": 84.93,
   "text": "Es un..."
  },
  {
   "start": 84.95,
   "end": 90.49,
   "text": "Un edificio blanco frente a un parque al costado de una farmacia."
  },
  {
   "start": 91.25,
   "end": 94.61,
   "text": "Perfecto. ¿A nombre de quién y un número de contacto?"
  },
  {
   "start": 94.79,
   "end": 103.25,
   "text": "A nombre de Ramírez. El número es 987-654-321."
  },
  {
   "start": 104.19,
   "end": 106.21,
   "text": "Gracias. ¿Y cómo va a pagar?"
  },
  {
   "start": 106.53,
   "end": 107.29,
   "text": "Con yape."
  },
  {
   "start": 108.21,
   "end": 114.33,
   "text": "Muy bien. Le confirmo el pedido. Un pollo entero, una papa familiar y dos jarras de chicha morada."
  },
  {
   "start": 114.95,
   "end": 118.97,
   "text": "Con el descuento del dúo familiar. El total es 96 soles."
  },
  {
   "start": 119.75,
   "end": 121.53,
   "text": "Perfecto. ¿Cuánto demora?"
  },
  {
   "start": 122.15,
   "end": 126.59,
   "text": "Entre 40 y 50 minutos. Le mandamos el número para el yape por mensaje."
  },
  {
   "start": 126.85,
   "end": 128.09,
   "text": "Listo. Gracias."
  },
  {
   "start": 128.63,
   "end": 130.43,
   "text": "Gracias a usted. Buenas noches."
  },
  {
   "start": 130.55,
   "end": 130.97,
   "text": "Gracias."
  }
 ],
