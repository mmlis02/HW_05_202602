 "segmentos": [
  {
   "start": 0.3,
   "end": 2.74,
   "text": "La leña o el dorado. Buenas noches."
  },
  {
   "start": 3.41,
   "end": 11.5,
   "text": "Hola, buenas noches. Quiero hacer un pedido. Somos tres personas y cada uno quiere su combo."
  },
  {
   "start": 11.98,
   "end": 14.0,
   "text": "Claro. ¿Qué le preparo?"
  },
  {
   "start": 14.94,
   "end": 19.58,
   "text": "Tres cuartos de pollo, cada uno con su papa personal."
  },
  {
   "start": 20.91,
   "end": 26.18,
   "text": "Tres cuartos de pollo a veinte soles cada uno. Y tres papas personales a siete."
  },
  {
   "start": 26.58,
   "end": 27.36,
   "text": "¿Bebidas?"
  },
  {
   "start": 27.36,
   "end": 30.24,
   "text": "Bebidas. Tres gaseosas personales."
  },
  {
   "start": 30.72,
   "end": 35.46,
   "text": "Tres gaseosas personales. Cuatro soles cada una. ¿Algún postre?"
  },
  {
   "start": 35.78,
   "end": 41.42,
   "text": "Sí. Dos porciones de torta de chocolate. El tercero está a dieta."
  },
  {
   "start": 42.53,
   "end": 47.9,
   "text": "Dos porciones de torta a nueve soles cada una. ¿Tiene algún código de promoción?"
  },
  {
   "start": 48.34,
   "end": 52.16,
   "text": "No, ninguno. ¿El pollo viene con cremas?"
  },
  {
   "start": 52.54,
   "end": 57.34,
   "text": "Sí. Mayonesa, ketchup, mostaza."
  },
  {
   "start": 57.36,
   "end": 59.12,
   "text": "Mostaza y ají de la casa."
  },
  {
   "start": 59.82,
   "end": 63.0,
   "text": "Perfecto. ¿Me pueden mandar extra de ají?"
  },
  {
   "start": 63.86,
   "end": 67.4,
   "text": "Claro, sin costo. ¿A qué dirección?"
  },
  {
   "start": 67.98,
   "end": 79.04,
   "text": "Girón Los Halcones, 1043, interior 5. No, perdón, me equivoqué. Es 1034."
  },
  {
   "start": 79.9,
   "end": 85.48,
   "text": "Girón Los Halcones, 1034, interior 5, en Jesús María."
  },
  {
   "start": 87.36,
   "end": 93.04,
   "text": "Girón Los Halcones, 1034, interior 5, forma de Pau."
  },
  {
   "start": 93.72,
   "end": 98.36,
   "text": "Con tarjeta. ¿El motorizado lleva POS?"
  },
  {
   "start": 99.04,
   "end": 111.82,
   "text": "Sí, lleva POS. Le repito su pedido. Tres cuartos de pollo, tres papas personales, tres gaseosas personales y dos porciones de torta de chocolate."
  },
  {
   "start": 112.3,
   "end": 115.46,
   "text": "Su total es 121."
  },
  {
   "start": 115.48,
   "end": 115.82,
   "text": "¿Cuánto cuesta un soles?"
  },
  {
   "start": 117.33,
   "end": 118.44,
   "text": "Ok, perfecto."
  },
  {
   "start": 119.04,
   "end": 121.76,
   "text": "Le llega en 45 minutos aproximadamente."
  },
  {
   "start": 122.44,
   "end": 124.48,
   "text": "Gracias. Buenas noches."
  },
  {
   "start": 124.54,
   "end": 125.58,
   "text": "Buenas noches."
  }
 ],
