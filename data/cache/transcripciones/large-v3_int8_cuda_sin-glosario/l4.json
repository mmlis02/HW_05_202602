 "segmentos": [
  {
   "start": 1.1,
   "end": 5.44,
   "text": "Buenas tardes, la leña dorada, área de delivery."
  },
  {
   "start": 6.9,
   "end": 11.1,
   "text": "Hola, buenas. Quiero hacer un pedido para mi oficina."
  },
  {
   "start": 11.72,
   "end": 13.02,
   "text": "Claro, dígame."
  },
  {
   "start": 14.14,
   "end": 19.5,
   "text": "Un medio pollo a la brasa, con ensalada clásica en vez de papas."
  },
  {
   "start": 19.5,
   "end": 31.42,
   "text": "Las guarniciones se piden aparte, así que lo anoto un medio pollo de 36 y una ensalada clásica de 10 soles."
  },
  {
   "start": 32.08,
   "end": 36.16,
   "text": "Perfecto. También dos porciones de mollejitas."
  },
  {
   "start": 39.97,
   "end": 43.15,
   "text": "Dos mollejitas, a 16 cada una."
  },
  {
   "start": 43.71,
   "end": 49.01,
   "text": "Ah, no, perdón. Solo una de mollejitas."
  },
  {
   "start": 49.83,
   "end": 52.65,
   "text": "Y agrégame una porción antiguísima."
  },
  {
   "start": 52.67,
   "end": 53.47,
   "text": "Anticuchos, mejor."
  },
  {
   "start": 54.15,
   "end": 59.79,
   "text": "Entonces, una de mollejitas y una de anticuchos."
  },
  {
   "start": 60.27,
   "end": 61.03,
   "text": "Para tomar."
  },
  {
   "start": 62.85,
   "end": 65.03,
   "text": "Dos vasos de chicha morada."
  },
  {
   "start": 66.01,
   "end": 69.89,
   "text": "Dos vasos de chicha, 5 soles cada uno."
  },
  {
   "start": 70.01,
   "end": 71.91,
   "text": "¿Tiene algún código?"
  },
  {
   "start": 72.87,
   "end": 75.31,
   "text": "Sí, el de la app."
  },
  {
   "start": 76.45,
   "end": 77.49,
   "text": "Leña 5."
  },
  {
   "start": 78.53,
   "end": 81.39,
   "text": "Perfecto, 5 soles de descuento."
  },
  {
   "start": 81.65,
   "end": 82.57,
   "text": "¿Dirección?"
  },
  {
   "start": 84.09,
   "end": 94.45,
   "text": "Calle Las Orquídeas 418, oficina 702, en Miraflores."
  },
  {
   "start": 94.71,
   "end": 99.37,
   "text": "Es un edificio de oficinas, que deja el pedido en recepción."
  },
  {
   "start": 100.59,
   "end": 108.47,
   "text": "Calle Las Orquídeas 418, oficina 702, dejar en recepción."
  },
  {
   "start": 108.65,
   "end": 109.79,
   "text": "¿Cómo paga?"
  },
  {
   "start": 110.25,
   "end": 110.97,
   "text": "Con plin."
  },
  {
   "start": 111.33,
   "end": 112.45,
   "text": "Muy bien."
  },
  {
   "start": 112.67,
   "end": 113.91,
   "text": "Le confirmo."
  },
  {
   "start": 114.31,
   "end": 123.67,
   "text": "Un medio pollo, una ensalada clásica, una porción de mollejitas, una porción de anticuchos"
  },
  {
   "start": 123.67,
   "end": 129.47,
   "text": "y dos vasos de chicha morada con el descuento de la app."
  },
  {
   "start": 129.73,
   "end": 131.83,
   "text": "El total es 85 soles."
  },
  {
   "start": 132.61,
   "end": 133.57,
   "text": "Perfecto, y no me llega."
  },
  {
   "start": 134.31,
   "end": 137.85,
   "text": "En 35 minutos está ahí."
  },
  {
   "start": 138.09,
   "end": 138.55,
   "text": "¿Qué?"
  }
 ],
