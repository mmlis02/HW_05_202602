 "segmentos": [
  {
   "start": 0.3,
   "end": 2.74,
   "text": "La leña Dourado. Buenas noches."
  },
  {
   "start": 3.38,
   "end": 5.12,
   "text": "Hola. Buenas noches."
  },
  {
   "start": 5.6,
   "end": 7.18,
   "text": "Quiero hacer un pedido."
  },
  {
   "start": 7.76,
   "end": 11.62,
   "text": "Somos tres personas y cada uno quiere su combo."
  },
  {
   "start": 12.38,
   "end": 14.06,
   "text": "Claro. Quiere preparo."
  },
  {
   "start": 15.16,
   "end": 19.8,
   "text": "Tres cuartos de pollo, cada uno con su papa personal."
  },
  {
   "start": 21.0,
   "end": 23.86,
   "text": "Tres cuartos de pollo a veinte soles cada uno."
  },
  {
   "start": 24.3,
   "end": 26.26,
   "text": "Y tres papas personales a siete."
  },
  {
   "start": 26.26,
   "end": 27.52,
   "text": "Bedidas."
  },
  {
   "start": 28.28,
   "end": 30.32,
   "text": "Tres haciosas personales."
  },
  {
   "start": 30.96,
   "end": 34.36,
   "text": "Tres haciosas personales. Cuatro soles cada una."
  },
  {
   "start": 34.8,
   "end": 35.56,
   "text": "Algún postre."
  },
  {
   "start": 36.34,
   "end": 39.34,
   "text": "Sí. Dos porciones de torta de chocolate."
  },
  {
   "start": 40.06,
   "end": 41.5,
   "text": "El tercero está a dieta."
  },
  {
   "start": 42.76,
   "end": 45.56,
   "text": "Dos porciones de torta a nueve soles cada una."
  },
  {
   "start": 46.24,
   "end": 48.0,
   "text": "¿Tiene algún código de promoción?"
  },
  {
   "start": 48.8,
   "end": 50.02,
   "text": "No. Ninguno."
  },
  {
   "start": 50.66,
   "end": 52.18,
   "text": "¿El pollo viene con cremas?"
  },
  {
   "start": 53.04,
   "end": 53.4,
   "text": "Sí."
  },
  {
   "start": 53.4,
   "end": 59.22,
   "text": "Mayonnaise, ketchup, mostaza y ají de la casa."
  },
  {
   "start": 60.02,
   "end": 63.1,
   "text": "Perfecto. ¿Me pueden mandar extra de ají?"
  },
  {
   "start": 64.08,
   "end": 65.58,
   "text": "Claro. Sin costo."
  },
  {
   "start": 66.48,
   "end": 67.34,
   "text": "¿A qué dirección?"
  },
  {
   "start": 68.38,
   "end": 72.36,
   "text": "Girón los alcones mil cuarenta y tres."
  },
  {
   "start": 72.76,
   "end": 73.92,
   "text": "Interior cinco."
  },
  {
   "start": 75.02,
   "end": 77.1,
   "text": "No. Perdón. Me equivoqué."
  },
  {
   "start": 77.62,
   "end": 79.36,
   "text": "Es mil treinta y cuatro."
  },
  {
   "start": 80.04,
   "end": 82.58,
   "text": "Girón los alcones mil treinta y cuatro."
  },
  {
   "start": 82.58,
   "end": 85.7,
   "text": "Interior cinco en Jesús María."
  },
  {
   "start": 86.42,
   "end": 89.16,
   "text": "Mil treinta y cuatro."
  },
  {
   "start": 90.1,
   "end": 91.28,
   "text": "Interior cinco."
  },
  {
   "start": 91.76,
   "end": 93.0,
   "text": "Forma de pau."
  },
  {
   "start": 94.16,
   "end": 95.34,
   "text": "Con tarjeta."
  },
  {
   "start": 95.98,
   "end": 98.4,
   "text": "¿El motorizado lleva POS?"
  },
  {
   "start": 99.52,
   "end": 101.74,
   "text": "Sí. Lleva POS."
  },
  {
   "start": 102.54,
   "end": 104.16,
   "text": "Le repito su pedido."
  },
  {
   "start": 105.44,
   "end": 106.48,
   "text": "Tres cuartos de pollo."
  },
  {
   "start": 107.18,
   "end": 108.4,
   "text": "Tres papas personales."
  },
  {
   "start": 108.64,
   "end": 110.3,
   "text": "Tres haciosas personales."
  },
  {
   "start": 110.3,
   "end": 111.94,
   "text": "Y dos porciones de torta de chocolate."
  },
  {
   "start": 112.64,
   "end": 115.94,
   "text": "Su total es ciento veintiún soles."
  },
  {
   "start": 117.68,
   "end": 119.08,
   "text": "Ok. Perfecto."
  },
  {
   "start": 119.3,
   "end": 121.8,
   "text": "Le llega en cuarenta y cinco minutos aproximadamente."
  },
  {
   "start": 122.64,
   "end": 124.5,
   "text": "Gracias. Buenas noches."
  },
  {
   "start": 125.02,
   "end": 125.66,
   "text": "Buenas noches."
  }
 ],
