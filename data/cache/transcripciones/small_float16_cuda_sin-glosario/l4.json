 "segmentos": [
  {
   "start": 1.1,
   "end": 5.8,
   "text": "Buenas tardes, la Leña Dorada, área de Deliberi."
  },
  {
   "start": 6.7,
   "end": 11.14,
   "text": "Hola, buenas. Quiero hacer un pedido para mi oficina."
  },
  {
   "start": 12.04,
   "end": 13.16,
   "text": "Claro, dígame."
  },
  {
   "start": 14.12,
   "end": 19.54,
   "text": "Un medio pollo a la brasa, con ensalada clásica en vez de papas."
  },
  {
   "start": 19.54,
   "end": 31.56,
   "text": "Las guarriniciones se piden aparte, así que lo anoto un medio pollo de 36 y una ensalada clásica de 10 soles."
  },
  {
   "start": 32.3,
   "end": 36.24,
   "text": "Perfecto. También dos porciones de mollejitas."
  },
  {
   "start": 39.89,
   "end": 43.23,
   "text": "Dos mollejitas, a 16 cada una."
  },
  {
   "start": 44.18,
   "end": 49.05,
   "text": "Ah, no, perdón. Sólo una de mollejitas."
  },
  {
   "start": 49.83,
   "end": 53.61,
   "text": "Y agrégame una por cena de anticuchos, mejor."
  },
  {
   "start": 54.43,
   "end": 59.93,
   "text": "Entonces una de mollejitas y una de anticuchos."
  },
  {
   "start": 60.33,
   "end": 61.13,
   "text": "¿Para tomar?"
  },
  {
   "start": 62.99,
   "end": 65.11,
   "text": "Dos vasos de chicha morada."
  },
  {
   "start": 65.83,
   "end": 69.99,
   "text": "Dos vasos de chicha 5 soles cada uno."
  },
  {
   "start": 69.99,
   "end": 71.99,
   "text": "¿Tiene algún código?"
  },
  {
   "start": 73.11,
   "end": 77.71,
   "text": "Sí, el de la app. Leña 5."
  },
  {
   "start": 78.73,
   "end": 82.65,
   "text": "Perfecto, 5 soles de descuento. Dirección?"
  },
  {
   "start": 84.03,
   "end": 89.35,
   "text": "Calle las orquídeas 418."
  },
  {
   "start": 90.29,
   "end": 94.53,
   "text": "Oficina 702 en Miraflores."
  },
  {
   "start": 94.53,
   "end": 99.53,
   "text": "Es un edificio de oficinas que deja el pedido en recepción."
  },
  {
   "start": 100.23,
   "end": 108.71,
   "text": "Calle las orquídeas 418, oficina 702, dejar en recepción."
  },
  {
   "start": 109.27,
   "end": 109.85,
   "text": "¿Cómo paga?"
  },
  {
   "start": 110.61,
   "end": 111.07,
   "text": "Con plín."
  },
  {
   "start": 111.87,
   "end": 113.95,
   "text": "Muy bien, le confirmo."
  },
  {
   "start": 114.63,
   "end": 123.67,
   "text": "Un medio pollo, una ensalada clásica, una porción de mollejitas, una porción de anticuchos"
  },
  {
   "start": 123.67,
   "end": 129.63,
   "text": "y dos vasos de chicha morada con el descuento de la app."
  },
  {
   "start": 129.93,
   "end": 132.13,
   "text": "El total es 85 soles."
  },
  {
   "start": 132.65,
   "end": 133.51,
   "text": "Perfecto, un medio."
  },
  {
   "start": 134.59,
   "end": 138.01,
   "text": "En 35 minutos está ahí."
  }
 ],
