 "segmentos": [
  {
   "start": 0.3,
   "end": 2.74,
   "text": "La leña Dourado. Buenas noches."
  },
  {
   "start": 3.38,
   "end": 7.18,
   "text": "Hola, buenas noches. Quiero hacer un pedido."
  },
  {
   "start": 7.76,
   "end": 11.62,
   "text": "Somos tres personas y cada uno quiere su combo."
  },
  {
   "start": 12.4,
   "end": 14.06,
   "text": "Claro. Quiere preparo."
  },
  {
   "start": 15.16,
   "end": 19.78,
   "text": "Tres cuartos de pollo, cada uno con su papa personal."
  },
  {
   "start": 21.0,
   "end": 23.86,
   "text": "Tres cuartos de pollo a veinte soles cada uno."
  },
  {
   "start": 24.3,
   "end": 26.26,
   "text": "Y tres papas personales a siete."
  },
  {
   "start": 26.26,
   "end": 27.52,
   "text": "Bedidas."
  },
  {
   "start": 28.28,
   "end": 30.3,
   "text": "Tres haciosas personales."
  },
  {
   "start": 30.94,
   "end": 34.36,
   "text": "Tres haciosas personales. Cuatro soles cada una."
  },
  {
   "start": 34.78,
   "end": 35.56,
   "text": "Algún postre."
  },
  {
   "start": 36.34,
   "end": 39.36,
   "text": "Sí, dos porciones de torta de chocolate."
  },
  {
   "start": 40.06,
   "end": 41.5,
   "text": "El tercero está a dieta."
  },
  {
   "start": 42.74,
   "end": 45.56,
   "text": "Dos porciones de torta a nueve soles cada una."
  },
  {
   "start": 46.24,
   "end": 48.0,
   "text": "¿Tiene algún código de promoción?"
  },
  {
   "start": 48.82,
   "end": 52.2,
   "text": "No, ninguno. El pollo viene con cremas."
  },
  {
   "start": 52.2,
   "end": 59.2,
   "text": "Sí, mayonesa, ketchup, mostaza y ají de la casa."
  },
  {
   "start": 60.1,
   "end": 63.12,
   "text": "Perfecto. ¿Me pueden mandar extra de ají?"
  },
  {
   "start": 64.08,
   "end": 67.36,
   "text": "Claro, sin costo. ¿A qué dirección?"
  },
  {
   "start": 68.4,
   "end": 72.36,
   "text": "Girón los alcones mil cuarenta y tres."
  },
  {
   "start": 72.76,
   "end": 73.9,
   "text": "Interior cinco."
  },
  {
   "start": 75.02,
   "end": 77.1,
   "text": "No, perdón, me equivoqué."
  },
  {
   "start": 77.6,
   "end": 79.34,
   "text": "Es mil treinta y cuatro."
  },
  {
   "start": 79.34,
   "end": 82.54,
   "text": "Girón los alcones mil treinta y cuatro."
  },
  {
   "start": 83.02,
   "end": 85.68,
   "text": "Interior cinco en Jesús María."
  },
  {
   "start": 86.58,
   "end": 89.18,
   "text": "Mil treinta y cuatro."
  },
  {
   "start": 90.0,
   "end": 91.28,
   "text": "Interior cinco."
  },
  {
   "start": 91.82,
   "end": 95.36,
   "text": "Con tarjeta."
  },
  {
   "start": 95.98,
   "end": 98.4,
   "text": "¿El motorizado lleva POS?"
  },
  {
   "start": 99.52,
   "end": 101.74,
   "text": "Sí, lleva POS."
  },
  {
   "start": 102.6,
   "end": 104.16,
   "text": "Le repito su pedido."
  },
  {
   "start": 105.32,
   "end": 106.48,
   "text": "Tres cuartos de pollo."
  },
  {
   "start": 107.1,
   "end": 108.38,
   "text": "Tres papas personales."
  },
  {
   "start": 108.38,
   "end": 110.4,
   "text": "Tres gaseosas personales."
  },
  {
   "start": 110.4,
   "end": 111.9,
   "text": "Y dos porciones de torta de chocolate."
  },
  {
   "start": 112.8,
   "end": 115.96,
   "text": "Su total es ciento veintiún soles."
  },
  {
   "start": 117.56,
   "end": 119.08,
   "text": "Ok, perfecto."
  },
  {
   "start": 119.5,
   "end": 121.8,
   "text": "Le llega en cuarenta y cinco minutos aproximadamente."
  },
  {
   "start": 122.7,
   "end": 124.46,
   "text": "Gracias. Buenas noches."
  },
  {
   "start": 124.94,
   "end": 125.64,
   "text": "Buenas noches."
  }
 ],
