 "segmentos": [
  {
   "start": 1.1,
   "end": 5.8,
   "text": "Buenas tardes, la Leña Dorada, área de Deliberi."
  },
  {
   "start": 6.7,
   "end": 11.14,
   "text": "Hola, buenas. Quiero hacer un pedido para mi oficina."
  },
  {
   "start": 11.96,
   "end": 13.14,
   "text": "Claro, dígame."
  },
  {
   "start": 14.12,
   "end": 19.54,
   "text": "Un medio pollo a la brasa, con ensalada clásica en vez de papas."
  },
  {
   "start": 20.3,
   "end": 23.36,
   "text": "Las guarriniciones se piden aparte."
  },
  {
   "start": 23.36,
   "end": 31.56,
   "text": "Así que lo anoto un medio pollo de 36 y una ensalada clásica de 10 soles."
  },
  {
   "start": 32.38,
   "end": 36.24,
   "text": "Perfecto. También dos porciones de mollejitas."
  },
  {
   "start": 39.91,
   "end": 43.21,
   "text": "Dos mollejitas, a 16 cada una."
  },
  {
   "start": 44.27,
   "end": 49.05,
   "text": "Ah, no, perdón, solo una de mollejitas."
  },
  {
   "start": 50.05,
   "end": 53.63,
   "text": "Y agrégame una porción de anticuchos, mejor."
  },
  {
   "start": 53.63,
   "end": 59.97,
   "text": "Entonces una de mollejitas y una de anticuchos."
  },
  {
   "start": 60.33,
   "end": 61.17,
   "text": "Para tomar."
  },
  {
   "start": 62.45,
   "end": 65.09,
   "text": "Dos vasos de hechicha morada."
  },
  {
   "start": 65.85,
   "end": 69.97,
   "text": "Dos vasos de hechicha, 5 soles cada uno."
  },
  {
   "start": 70.37,
   "end": 71.99,
   "text": "¿Tiene algún código?"
  },
  {
   "start": 73.05,
   "end": 77.71,
   "text": "Sí, el de la app. Leña 5."
  },
  {
   "start": 78.63,
   "end": 81.47,
   "text": "Perfecto, 5 soles de descuento."
  },
  {
   "start": 81.47,
   "end": 82.61,
   "text": "¿Dirección?"
  },
  {
   "start": 84.29,
   "end": 94.55,
   "text": "Calle las orquídeas 418, oficina 702 en Miraflores."
  },
  {
   "start": 95.23,
   "end": 99.51,
   "text": "Es un edificio de oficinas que deja el pedido en recepción."
  },
  {
   "start": 100.57,
   "end": 108.69,
   "text": "Calle las orquídeas 418, oficina 702, dejar en recepción."
  },
  {
   "start": 109.25,
   "end": 109.85,
   "text": "¿Cómo paga?"
  },
  {
   "start": 109.85,
   "end": 111.09,
   "text": "Con plim."
  },
  {
   "start": 111.49,
   "end": 113.95,
   "text": "Muy bien, le confirmo."
  },
  {
   "start": 114.57,
   "end": 120.87,
   "text": "Un medio pollo, una ensalada clásica, una porción de mollejitas,"
  },
  {
   "start": 121.61,
   "end": 127.01,
   "text": "una porción de anticuchos y dos vasos de hechicha morada"
  },
  {
   "start": 127.01,
   "end": 129.63,
   "text": "con el descuento de la app."
  },
  {
   "start": 129.99,
   "end": 131.87,
   "text": "El total es 85 soles."
  },
  {
   "start": 132.71,
   "end": 133.65,
   "text": "¿Pero que no me digas?"
  },
  {
   "start": 134.63,
   "end": 137.95,
   "text": "En 35 minutos está ahí."
  },
  {
   "start": 137.95,
   "end": 138.57,
   "text": "¿Qué?"
  }
 ],
